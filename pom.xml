<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cantalay.keycloak</groupId>
    <artifactId>talay-keycloak-providers</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>Talay Keycloak providers</name>
    <description>Talay platformunun Keycloak eklentileri: Game Center ve Play Games kimliğiyle giriş (direct grant) ve hesap bağlama; sosyal girişte yalnız onaylı hesaba bağlama.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <keycloak.version>26.7.3</keycloak.version>
        <apple.idp.version>1.17.0</apple.idp.version>
        <apple.idp.sha512>04949c18bd2819f6134f7a8fdf446e471036241c537d451e7bf1c627d8eefb1f72374d238bf0037155e725531c587065cfabf1c3f0b7f0df86fb7138effd6bba</apple.idp.sha512>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Keycloak çalışma anında sağlar (provided): sürüm canlıdaki Keycloak ile aynı tutulur. -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Entegrasyon testleri (*IT, failsafe): eklenti JAR'ı yüklü gerçek Keycloak kapsayıcısı. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>talay-keycloak-providers</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- *IT: paketlenmiş JAR'la (package evresinden sonra) Keycloak kapsayıcısında; Docker yoksa atlanır. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <it.providers.jar>${project.build.directory}/${project.build.finalName}.jar</it.providers.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Apple ile giriş (klausbetz/apple-identity-provider-keycloak, Keycloak >= 26.5 için 1.17.x): hazır sürüm JAR'ı
                 indirilip imaja ikinci eklenti olarak girer; SHA-512 sürüm sayfasındaki değerdir. Sürüm yükseltirken ikisini birlikte değiştirin. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <execution>
                        <id>apple-identity-provider</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://github.com/klausbetz/apple-identity-provider-keycloak/releases/download/${apple.idp.version}/apple-identity-provider-${apple.idp.version}.jar</url>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <outputFileName>apple-identity-provider.jar</outputFileName>
                            <sha512>${apple.idp.sha512}</sha512>
                            <skipCache>true</skipCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
